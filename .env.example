# Google Gemini API Key (Required for server-side assistant and tool calling)
# Get your free-tier API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Security & Rate Limiting
# Allowed requests per IP per minute
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Action Confirmation Expiry in milliseconds (default 5 minutes)
ACTION_CONFIRMATION_TTL_MS=300000

# Node Environment
NODE_ENV=development
